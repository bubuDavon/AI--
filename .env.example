# OpenHex 服务端凭据。两套 Agent 必须使用各自的 Key 与 ID；不要提交真实的 .env 文件。
OPENHEX_OFFICIAL_API_KEY=请替换为官网咨询_Agent_API_Key
OPENHEX_OFFICIAL_AGENT_ID=请替换为官网咨询_Agent_ID
OPENHEX_LEARNING_API_KEY=请替换为学习助教_Agent_API_Key
OPENHEX_LEARNING_AGENT_ID=请替换为学习助教_Agent_ID

# 仅供本地 server.mjs 使用；Netlify Functions 不需要端口。
PORT=8787
